{
    "name": "karelwintersky/freshtracker",
    "description": "Fresh Tracker — household food inventory with expiry control",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "karelwintersky",
            "email": "karel@wintersky.ru"
        }
    ],
    "autoload": {
        "psr-4": {
            "FreshTracker\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FreshTracker\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-readline": "*",
        "psr/log": "*",
        "karelwintersky/arris.config": "^2.0",
        "karelwintersky/arris.router": "^2.3",
        "karelwintersky/arris.logger": "^2.1",
        "karelwintersky/arris.database": "^2.5",
        "karelwintersky/arris.request": "^0.99",
        "karelwintersky/arris.toolkit.firewall": "^1.1",
        "karelwintersky/arris.toolkit.cli-console": "^1.6",
        "symfony/yaml": "^7.4"
    },
    "config": {
        "secure-http": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "@php tests/run.php",
        "migrate": "@php bin/ft migrate"
    }
}
